# Keep this file public. Put real values only in .env.local or your VPS vault.
OPENAI_API_KEY=
# GPT-5.6 routing. Keep Luna as the everyday model; escalate complex or
# consequential cases to Terra and Sol.
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENAI_REASONING_LUNA=medium
OPENAI_MODEL_TERRA=gpt-5.6-terra
OPENAI_REASONING_TERRA=high
OPENAI_MODEL_SOL=gpt-5.6-sol
OPENAI_REASONING_SOL=xhigh
BUSINESS_NAME=LODEX Construction Maintenance and Repair
BUSINESS_PHONE=
LEAD_EMAIL=
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=data/uploads

# Owner dashboard. In production this is materialized from the encrypted VPS
# vault and may share the Operations Center administrator token.
LODEX_ADMIN_TOKEN=

# Stripe-hosted consultation checkout. Keep real values in .env.local or the
# VPS runtime vault; never commit secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Legacy records only. New project pricing is calculated and persisted server-side.
LODEX_DEPOSIT_AMOUNT_CENTS=
# Visit pricing defaults: Home small=$50, several=$100, major=$150;
# Business=$300; first 5 miles included; then $2.50/mile.
LODEX_HOME_SMALL_VISIT_CENTS=5000
LODEX_HOME_SEVERAL_VISIT_CENTS=10000
LODEX_HOME_MAJOR_VISIT_CENTS=15000
LODEX_BUSINESS_ASSESSMENT_CENTS=30000
LODEX_INCLUDED_DISTANCE_MILES=5
LODEX_DISTANCE_RATE_CENTS_PER_MILE=250
# Enterprise uses custom assessment pricing and does not create an automatic checkout
# unless an administrator-approved amount is persisted on the project.
# Optional overrides; otherwise FRONTEND_ORIGIN is used.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
