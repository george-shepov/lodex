# Keep this file public. Put real values only in .env.local or your VPS vault.
OPENAI_API_KEY=
## Set this in the vault to a vision-capable Responses API model available to your project.
OPENAI_MODEL=gpt-4.1-mini
BUSINESS_NAME=LODEX Construction Maintenance and Repair
BUSINESS_PHONE=
LEAD_EMAIL=
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=data/uploads

# Stripe-hosted one-time deposit checkout. Keep real values in .env.local or
# the VPS runtime vault; never commit secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
LODEX_DEPOSIT_AMOUNT_CENTS=
# Optional overrides; otherwise FRONTEND_ORIGIN is used.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
