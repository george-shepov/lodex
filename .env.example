# Keep this file public. Put real values only in .env.local or your VPS vault.
OPENAI_API_KEY=
## Set this in the vault to a vision-capable Responses API model available to your project.
OPENAI_MODEL=gpt-4.1-mini
BUSINESS_NAME=LODEX Construction Maintenance and Repair
BUSINESS_PHONE=
LEAD_EMAIL=
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=data/uploads

# PostgreSQL is internal to the Docker deployment. Set this only when running the API outside Compose.
DATABASE_URL=

# Owner alerts. Configure either or both after choosing your mail/SMS provider.
LEAD_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
LEAD_SMS_TO=
